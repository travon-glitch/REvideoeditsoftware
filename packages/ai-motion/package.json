{
  "name": "@lvs/ai-motion",
  "version": "0.1.0",
  "private": true,
  "description": "AI Enhanced camera motion: depth-based 3D camera moves from one photo (MiDaS depth model, runs locally) and image-to-video providers. Includes the generation worker.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "start": "node --env-file-if-exists=../../apps/web/.env.local src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lvs/camera-presets": "*",
    "@supabase/supabase-js": "2.118.0",
    "onnxruntime-node": "1.20.1"
  }
}
