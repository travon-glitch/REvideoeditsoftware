# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in invitation and password-reset emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stage 9: AI Video Director (Claude) ─────────────────────────────────────
# 32 random bytes, base64 — encrypts the Claude API key a Super Admin saves in System settings.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LVS_SECRETS_KEY=
# Optional: a server-wide Claude API key, used when no key is saved in System settings.
ANTHROPIC_API_KEY=
